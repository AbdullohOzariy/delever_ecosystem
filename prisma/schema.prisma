// Bu fayl ma'lumotlar bazasi strukturasini belgilaydi

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// ENUMLAR
// ---------------------------------------------------------

enum UserRole {
  ADMIN
  OPERATOR
  COURIER
  CASHIER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PAID
  BLOCKED
}

enum PayoutFrequency {
  WEEKLY
  MONTHLY
}

enum ShiftType {
  MORNING
  EVENING
  FULL
  OFF
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  SICK
}

// ---------------------------------------------------------
// MODELLAR
// ---------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  fullName  String
  password  String
  role      UserRole
  status    UserStatus @default(ACTIVE)
  telegramId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Aloqalar
  ordersAsOperator Order[]       @relation("OperatorOrders")
  ordersAsCourier  Order[]       @relation("CourierOrders")
  payments         Payment[]
  schedules        WorkSchedule[]
  dailyKPIs        DailyKPI[]

  // Baholash
  ratingsReceived  Rating[]      @relation("ReceivedRatings")
  ratingsGiven     Rating[]      @relation("GivenRatings")

  // Imtihonlar (YANGI)
  examResults      ExamResult[]

  @@map("users")
}

model Rating {
  id          String   @id @default(uuid())

  fromUserId  String
  fromUser    User     @relation("GivenRatings", fields: [fromUserId], references: [id])

  toUserId    String
  toUser      User     @relation("ReceivedRatings", fields: [toUserId], references: [id])

  score       Int      // 1-5
  comment     String?
  date        DateTime @default(now()) @db.Date

  createdAt   DateTime @default(now())

  @@unique([fromUserId, toUserId, date])
  @@map("ratings")
}

// IMTIHON TIZIMI (YANGI)
model Exam {
  id          String   @id @default(uuid())
  title       String   // Masalan: "Mart oyi imtihoni"
  questions   Json     // Savollar va javoblar (JSON formatda)
  createdAt   DateTime @default(now())

  results     ExamResult[]

  @@map("exams")
}

model ExamResult {
  id          String   @id @default(uuid())

  examId      String
  exam        Exam     @relation(fields: [examId], references: [id])

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  score       Int      // Masalan: 8 (10 dan)
  total       Int      // Masalan: 10
  details     Json?    // Qaysi savolga qanday javob berdi

  date        DateTime @default(now())

  @@map("exam_results")
}

model WorkSchedule {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])

  date      DateTime  @db.Date
  shift     ShiftType
  status    AttendanceStatus @default(PRESENT)

  createdAt DateTime  @default(now())

  @@unique([userId, date])
  @@map("work_schedules")
}

model DailyKPI {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])

  date      DateTime  @db.Date

  scriptScore     Float?
  errorScore      Float?
  disciplineScore Float?

  bonusAmount     Decimal  @default(0) @db.Decimal(10, 2)
  isConfirmed     Boolean  @default(false)

  ordersCount     Int      @default(0)
  avgSpeedSeconds Int      @default(0)
  avgCheckAmount  Decimal  @default(0) @db.Decimal(10, 2)

  comment         String?

  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@map("daily_kpi")
}

model Order {
  id           String      @id
  customerName String
  address      String
  amount       Decimal     @db.Decimal(10, 2)
  deliveryPrice Decimal    @db.Decimal(10, 2)
  deliveryType String?
  branch       String?
  status       OrderStatus @default(PENDING)

  createdAt    DateTime    @default(now())
  deliveredAt  DateTime?
  deliveryTimeSeconds Int?

  operatorId   String?
  operator     User?       @relation("OperatorOrders", fields: [operatorId], references: [id])

  courierId    String?
  courier      User?       @relation("CourierOrders", fields: [courierId], references: [id])

  @@map("orders")
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id])

  amount            Decimal         @db.Decimal(10, 2)
  status            PayoutStatus    @default(PENDING)
  frequency         PayoutFrequency
  period            String

  feedbackCompleted Boolean         @default(false)
  processedAt       DateTime?

  createdAt         DateTime        @default(now())

  @@map("payments")
}
