# ===========================================================
# Frontend (Vite) — build paytida kerak
# ===========================================================
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ===========================================================
# Database (Neon)
# Neon dashboard'dan oling:
#   DATABASE_URL  -> "Pooled connection" (host'da -pooler bor)
#   DIRECT_URL    -> "Direct connection" (migration uchun)
# ===========================================================
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/dbname?sslmode=require"

# ===========================================================
# Backend
# ===========================================================
# Railway PORT'ni avtomatik beradi — lokalda 3001
PORT=3001
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Security — production'da ALBATTA yangi qiymatlar qo'ying!
JWT_SECRET=generate_a_long_random_string
ADMIN_DEFAULT_PASSWORD=change_me
NEW_USER_DEFAULT_PASSWORD=change_me

# CORS — single-service deploy'da bir xil origin, lekin lokal dev uchun:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
